# ==============================================================================
# Monarch Pass Apartments - Backend Security Protection
# ==============================================================================

# Protect .env, .sql, .json, and sensitive config files
<FilesMatch "^\.env|\.sql$|\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
