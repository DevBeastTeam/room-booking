# ==============================================================================
# Monarch Pass Apartments - Environment Template (Duplicate as .env for deployment)
# ==============================================================================
# NOTE: Saari values neeche FAKE placeholders hain. Apni asli credentials
# backend/config/.env mein daalein — us file ko git mein commit na karein.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=roombookingdb
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

APP_ENV=production
APP_DEBUG=false

LEASING_EMAIL=leasing@monarchpassapts.com
SITE_URL=https://monarchpassapts.com

# Super Admin credential encryption key (change this in production!)
# Is key se admin passwords reversible-encrypt hoti hain takke super admin
# (/dev) unhe dekh/reset kar sake. Ye key badalne se purane encrypted
# passwords recover nahi honge (un admins ko reset karna hoga).
ADMIN_CRED_KEY=change-this-to-a-long-random-string-in-production

# Web se migration chalane ke liye setup key (php backend/migrations/migrate.php
# CLI se bina key chalta hai). Isko ek lambi random string se replace karein.
SETUP_KEY=change-this-setup-key-in-production

# Paddle Payment Gateway Configuration
# Keys sirf backend/config/.env mein rakhein — frontend mein kabhi hardcode na karein.
# Agar PADDLE_API_KEY / PADDLE_SANDBOX_API_KEY khali ho to paddle.php demo mode
# mein chalta hai (simulated payment, txn pending rehta hai).
PADDLE_ENV=sandbox
PADDLE_API_KEY=test_xxxxxxxxxxxxxxxxxxxx
PADDLE_CLIENT_SIDE_TOKEN=test_xxxxxxxxxxxxxxxxxxxx
PADDLE_VENDOR_ID=000000
PADDLE_VENDOR_AUTH_CODE=test_xxxxxxxxxxxxxxxxxxxx
PADDLE_CURRENCY=USD
