# ==============================================================================
# Monar Pass Apartments - Environment Configuration Template
# Copy this file to `backend/config/.env` and fill in real values.
# `backend/config/.env` is git-ignored and blocked by .htaccess.
# ==============================================================================

# ── Database ───────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u114120454_roombooking
DB_USER=u114120454_roombooking
DB_PASS=U114120454_roombooking
DB_CHARSET=utf8mb4

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi

LEASING_EMAIL=leasing@monarpass.com
SITE_URL=https://monarpass.com

# ==============================================================================
# ⚠️  SECURITY — READ BEFORE GOING LIVE
# ==============================================================================

# Key used to encrypt admin passwords (AES-256-GCM).
# If this is left at the default, a random key is generated and stored in
# backend/data/.cred_key — which means admin passwords can no longer be
# recovered after the file is lost. Set a long random string in production.
ADMIN_CRED_KEY=change-me-to-a-long-random-string

# Super admin (dev panel) password.
# When set, this strong password is ALWAYS accepted and the session never
# expires on a date change.
ADMIN_SUPER_PASSWORD=change-me-to-a-strong-unique-password

# Legacy behaviour: allow the super admin to log in with today's day number
# (e.g. "10" on the 10th). Convenient, but guessable — keep this OFF in
# production and use ADMIN_SUPER_PASSWORD instead.
ADMIN_ALLOW_DATE_PASSWORD=false

# Force seeded accounts (admin / manager) to rotate their default password
# the first time they sign in.
AUTH_FORCE_PASSWORD_CHANGE=true

# Brute-force protection for the login form.
AUTH_MAX_LOGIN_ATTEMPTS=8
AUTH_LOCKOUT_MINUTES=15

# ==============================================================================
# WorldFirst (WorldFirst Pay / Ant International) Payment Gateway Configuration
# Mode: 'sandbox' (testing) or 'live' (production)
# ==============================================================================
WORLDFIRST_ENV=sandbox

# WorldFirst Portal Login & Merchant Dashboard:
# Sign in or Register at: https://portal.worldfirst.com
# WorldFirst Developer Open Platform: https://open.worldfirst.com

# 1. WorldFirst Client ID / Partner App ID
# Generate at: https://open.worldfirst.com/platform/app/manage
WORLDFIRST_CLIENT_ID=your_worldfirst_client_id

# 2. WorldFirst Merchant Account ID
# Found in your WorldFirst Account Profile: https://portal.worldfirst.com/account/details
WORLDFIRST_MERCHANT_ID=your_worldfirst_merchant_id

# 3. WorldFirst API Key / Client Secret
# Generate at: https://open.worldfirst.com/platform/developer/keys
WORLDFIRST_API_KEY=your_worldfirst_api_key

# 4. Merchant RSA Private Key (used to sign API requests — REQUIRED for live)
# Generate keypair guide: https://open.worldfirst.com/docs/api/security/signature
# You may also point this at a file path containing the PEM.
WORLDFIRST_PRIVATE_KEY=""

# 5. WorldFirst Public Key (for verifying webhook callback signatures)
# Download from: https://open.worldfirst.com/platform/developer/keys
WORLDFIRST_PUBLIC_KEY=""

# 6. Webhook Signing Secret (Set in WorldFirst Webhook Notification settings)
# Setup at: https://open.worldfirst.com/platform/app/webhooks
# Without this, inbound webhooks are rejected with HTTP 401.
WORLDFIRST_WEBHOOK_SECRET=your_webhook_signing_secret

# 7. Payment Currency (Default: USD)
WORLDFIRST_CURRENCY=USD

# 8. Auto-Subscription / Recurring Billing Configuration
# Default interval: 'monthly' (every 30 days) or '3_days' (fast test cycle)
WORLDFIRST_SUBSCRIPTION_ENABLED=true
WORLDFIRST_SUBSCRIPTION_DEFAULT_INTERVAL=monthly
