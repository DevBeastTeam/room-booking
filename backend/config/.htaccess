# ==============================================================================
# Monarch Pass Apartments - Config Security Protection
# Deny all direct web access to sensitive config files (.env, database.php)
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
