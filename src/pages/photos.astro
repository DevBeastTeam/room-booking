---
import Layout from '../layouts/Layout.astro';
import PhotoGallery, { PHOTO_GALLERY_IMAGES } from '../components/PhotoGallery.jsx';

const imageGallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  'name': 'Monarch Pass Apartments Photo Gallery',
  'description': 'High-resolution photographs of Monarch Pass Apartments interiors, amenities, splash park, and community grounds in Fort Worth, TX.',
  'image': PHOTO_GALLERY_IMAGES.slice(0, 10).map((img) => ({
    '@type': 'ImageObject',
    'contentUrl': img.src,
    'thumbnailUrl': img.thumb,
    'name': img.title,
    'description': img.description,
  })),
};
---

<Layout
  title="Photo Gallery | Monarch Pass Apartments Fort Worth TX"
  description="Explore 26 high-resolution photos of Monarch Pass Apartments in Fort Worth, TX. View renovated kitchens, spacious living areas, fitness center, splash park, and lush grounds."
  currentView="photos"
  schemaData={imageGallerySchema}
>
  <div class="sr-only">
    <h1>Monarch Pass Apartments Photo Gallery</h1>
    <p>
      Browse 26 professional photos of Monarch Pass in Fort Worth, TX. See our modern kitchens with black appliances,
      wood-style plank flooring, spacious bedrooms with walk-in closets, children's playground, tennis pavilion,
      and community clubhouse.
    </p>
  </div>

  <div style="padding: 1.5rem 0 3rem;">
    <div class="container">
      <PhotoGallery client:load />
    </div>
  </div>
</Layout>
