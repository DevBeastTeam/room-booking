---
import Layout from '../layouts/Layout.astro';
import IncomeGuidelines, { INCOME_LIMITS } from '../components/IncomeGuidelines.jsx';

const incomeGuidelinesSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Monarch Pass Income Guidelines & Affordable Housing Limits',
  'description': 'Affordable housing income qualifications and Area Median Income (AMI) limits for Monarch Pass Apartments in Fort Worth, TX.',
  'mainEntity': {
    '@type': 'Table',
    'about': 'Fort Worth Area Median Income (AMI) Household Limits for Monarch Pass',
  },
};
---

<Layout
  title="Income Guidelines & Qualification | Monarch Pass Fort Worth TX"
  description="Learn about Monarch Pass Apartments affordable housing income guidelines in Fort Worth, TX. View 2026 AMI income limits by household size and check your eligibility online."
  currentView="guidelines"
  schemaData={incomeGuidelinesSchema}
>
  <div class="sr-only">
    <h1>Monarch Pass Affordable Housing Income Guidelines & Limits</h1>
    <p>
      Monarch Pass Apartments participates in an affordable housing program in Fort Worth, TX designed to provide
      high-quality, affordable housing options for individuals and families.
      Maximum annual gross household income limits for 80% AMI and 140% AMI apply based on household size (1 to 10 persons).
    </p>
  </div>

  <div style="padding: 1.5rem 0 3rem;">
    <div class="container">
      <IncomeGuidelines client:load />
    </div>
  </div>
</Layout>
