# ==============================================================================
# Monar Pass Apartments - cPanel Apache Configuration
# ==============================================================================

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle directory trailing slash
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.+[^/])$ $1/ [L,R=301]

    # Transparently rewrite /api/ requests to modular /backend/api/
    RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]
</IfModule>

# ── Enable Gzip / Brotli Compression ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Browser Caching Headers ───────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML - short cache for instant updates
    ExpiresByType text/html "access plus 0 seconds"

    # Data
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"

    # Static Assets (Images, Fonts, Media)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ── Security Headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Clickjacking / embedding protection
    Header set X-Frame-Options "SAMEORIGIN"
    # frame-src must list every host we actually embed:
    #   tour.tourbuilder.com  -> the 3D virtual tour iframe
    #   maps.google.com       -> the location map iframe
    #   *.matterport.com      -> Matterport tours (kept for future use)
    Header set Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https:; frame-src 'self' https://tour.tourbuilder.com https://maps.google.com https://www.google.com https://*.matterport.com; child-src 'self' https://tour.tourbuilder.com https://maps.google.com"

    # HSTS (only meaningful over HTTPS, which Hostinger enforces)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Do not expose the browser fingerprint surface we do not need
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self), interest-cohort=()"

    # Never cache the API / admin responses
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
